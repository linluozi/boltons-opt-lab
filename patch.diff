         return value, False
     elif isinstance(value, Mapping):
         return value.__class__(), ItemsView(value)
@@ -1129,7 +1136,12 @@ def default_exit(path, key, old_parent, new_parent, new_items):
     # print('exit(%r, %r, %r, %r, %r)'
