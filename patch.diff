+        new_parent.update(new_items)
+    elif cls is list:
+        new_parent.extend([v for i, v in new_items])
+    elif isinstance(new_parent, Mapping):
         new_parent.update(new_items)
     elif isinstance(new_parent, Sequence):
         vals = [v for i, v in new_items]
